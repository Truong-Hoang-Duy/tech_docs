+def _enrich_quick_edit_payload(db: Session, payload: QuickEditRequest, document_ids: list[str]) -> QuickEditRequest:
+    from bookforge_api.models.document import Document
+    from bookforge_api.schemas.assistant_tools import QuickEditDocMetadata
+    from bookforge_api.services.quick_edit_rails import infer_subject_and_grade_from_context
+
+    meta: dict[str, Any] = payload.doc_metadata.model_dump() if payload.doc_metadata else {}
+    hint_texts: list[str] = []
+
+    if document_ids:
+        doc = db.get(Document, document_ids[0])
+        if doc is not None:
+            doc_meta = doc.metadata_json if isinstance(doc.metadata_json, dict) else {}
+            for key in ('subject', 'grade', 'doc_type', 'audience'):
+                if not meta.get(key) and doc_meta.get(key):
+                    meta[key] = str(doc_meta[key]).strip()[:80]
+            if not meta.get('doc_type') and doc.document_type:
+                meta['doc_type'] = str(doc.document_type).strip()[:80]
+            if doc.title:
+                hint_texts.append(str(doc.title))
+
+    if payload.context_before:
+        hint_texts.append(payload.context_before)
+    if payload.context_after:
+        hint_texts.append(payload.context_after)
+
+    for hint in hint_texts:
+        _subj_key, subj_label, grade = infer_subject_and_grade_from_context(hint)
+        if subj_label and not meta.get('subject'):
+            meta['subject'] = subj_label[:80]
+        if grade is not None and not meta.get('grade'):
+            meta['grade'] = f'Lớp {grade}'
+        if meta.get('subject') and meta.get('grade'):
+            break
+
+    if not any(meta.values()):
+        return payload
+    return payload.model_copy(update={'doc_metadata': QuickEditDocMetadata(**meta)})
+
+
