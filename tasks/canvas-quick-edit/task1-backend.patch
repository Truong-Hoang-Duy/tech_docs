+def infer_subject_and_grade_from_context(text: str) -> tuple[str | None, str | None, int | None]:
+    """Infer `(subject_key, subject_label, grade)` from document title or free text without false-positive single words."""
+    from bookforge_api.services.bookforge_default_kb import fold_vi
+
+    folded = fold_vi(text)
+    if not folded:
+        return None, None, None
+    subject_key: str | None = None
+    subject_label: str | None = None
+    for code, label, pattern in _EXPLICIT_SUBJECT_PATTERNS:
+        if pattern.search(folded):
+            subject_key = code
+            subject_label = label
+            break
+    grade: int | None = None
+    m_grade = _EXPLICIT_GRADE_RE.search(folded) or _SUBJECT_GRADE_RE.search(folded)
+    if m_grade:
+        grade = int(m_grade.group(1))
+    return subject_key, subject_label, grade
+
+
+def _is_word_char(ch: str) -> bool:
+    return ch.isalnum() or ch == '_'
+
+
+def _find_whole_phrase_span(
+    lowered_text: str, phrase_lower: str, blocked: bytearray | None = None
+) -> tuple[int, int] | None:
+    if not phrase_lower:
+        return None
+    start = 0
+    plen = len(phrase_lower)
+    tlen = len(lowered_text)
+    while True:
+        idx = lowered_text.find(phrase_lower, start)
+        if idx < 0:
+            return None
+        end = idx + plen
+        left_ok = idx == 0 or not _is_word_char(lowered_text[idx - 1])
+        right_ok = end == tlen or not _is_word_char(lowered_text[end])
+        if left_ok and right_ok:
+            if blocked is None or not any(blocked[idx:end]):
+                return idx, end
+        start = idx + 1
+
+
+def _is_eligible_lock_term(term: str, subject_key: str) -> bool:
+    words = term.split()
+    if len(words) >= 2:
+        return True
+    if not words:
+        return False
+    word = words[0]
+    if len(word) < 2:
+        return False
+    if subject_key == 'tieng_anh':
+        return len(word) >= 4
+    return (
+        word.isascii()
+        or any(ch.isdigit() or ch in '-/()' for ch in word)
+        or any(ch.isupper() for ch in word[1:])
+        or len(word) >= 7
+        or word.lower() in _LOANWORD_1W_TERMS
+    )
+
+
+def _is_eligible_alias(alias: str, term: str) -> bool:
+    from bookforge_api.services.bookforge_default_kb import fold_vi
+
+    cleaned = alias.strip()
+    if len(cleaned) < 2 or cleaned.lower() == term.strip().lower():
+        return False
+    folded = fold_vi(cleaned)
+    if not folded or folded in _SKIP_ALIAS_FOLD:
+        return False
+    if len(cleaned.split()) >= 2:
+        return True
+    return cleaned.isupper() or (cleaned.isascii() and len(cleaned) >= 4) or any(ch.isdigit() for ch in cleaned)
+
 
